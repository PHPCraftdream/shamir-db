# Enforces the "engines" constraint in package.json (Node >=22.12, needed
# since task #919's require()-of-ESM design for @shamir/client) as a hard
# npm-install failure instead of a soft warning + a later, confusing
# ERR_REQUIRE_ESM at test-run time. Scoped to this directory only (does not
# affect crates/shamir-client-ts or crates/shamir-client-node, which have
# their own, different engines constraints).
engine-strict=true
