{
  "name": "shamir-client",
  "version": "0.1.0",
  "description": "ShamirDB Node.js client SDK — TLS 1.3 + SCRAM-Argon2id, native binding to the Rust shamir-client crate.",
  "main": "js/wrapper.js",
  "types": "js/wrapper.d.ts",
  "files": [
    "js/wrapper.js",
    "js/wrapper.d.ts",
    "native/index.js",
    "native/index.d.ts",
    "native/shamir-client.*.node"
  ],
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "shamir-client",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --output-dir native --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --output-dir native --js index.js --dts index.d.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "typescript": "7.0.2"
  }
}
